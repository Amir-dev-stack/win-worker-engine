export function normalizeSportName(input: unknown): string {
  const raw = typeof input === "string" ? input.trim().toLowerCase() : "";
  if (!raw) return "unknown";
  const found = SPORT_REGISTRY.find(s => s.id === raw || s.label.toLowerCase() === raw || s.aliases.some(a => a.toLowerCase() === raw));
  return found?.id || raw.replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "") || "unknown";
}
export function getSportCapability(input: unknown): SportCapability | null {
  const id = normalizeSportName(input);
  return SPORT_REGISTRY.find(s => s.id === id) || null;
}
export function listSportCapabilities() {
  return SPORT_REGISTRY.map(({ id, label, aliases, eventFormats, participantTypes, coreMetrics, contextMetrics, marketFamilies }) => ({
    id, label, aliases, eventFormats, participantTypes, coreMetrics, contextMetrics, marketFamilies
  }));
}
